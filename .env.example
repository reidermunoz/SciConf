# ==============================================================================
# Plantilla de variables de entorno para SciConf
# Copia este archivo como .env y completa los valores correspondientes.
# NUNCA subas el archivo .env real al repositorio de Git.
# ==============================================================================

# Configuración de Django
# Generar una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-segura
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos (PostgreSQL / Supabase)
DB_NAME=postgres
DB_USER=postgres.tu_identificador_de_proyecto
DB_PASSWORD=tu_contraseña_de_base_de_datos
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432

# Configuración de Correo Electrónico (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=SciConf <tucorreo@gmail.com>
